{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/auth/confirm", "destination": "/index.html" },
    { "source": "/reset-password", "destination": "/index.html" },
    { "source": "/nuevo", "destination": "/index.html" },
    { "source": "/editar/:id", "destination": "/index.html" },
    { "source": "/listado", "destination": "/index.html" },
    { "source": "/estadisticas", "destination": "/index.html" },
    { "source": "/seguimiento", "destination": "/index.html" },
    { "source": "/ajustes", "destination": "/index.html" },
    { "source": "/importar", "destination": "/index.html" },
    { "source": "/revision-catalogo", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/registerSW.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
